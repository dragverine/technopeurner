---
import HelpCenterLayout from '@/layouts/HelpCenterLayout.astro';
import HelpNavbar from '@/components/help/HelpNavbar.astro';
import HelpFooter from '@/components/help/HelpFooter.astro';
import Sidebar from '@/components/help/Sidebar.astro';
import Breadcrumb from '@/components/help/Breadcrumb.astro';
import ArticleCard from '@/components/help/ArticleCard.astro';
import { getModules, getArticlesBySubcategory } from '@/lib/help-center';
import type { Module, SubCategory } from '@/lib/help-center';

export function getStaticPaths() {
  const modules = getModules();
  return modules.flatMap((mod) =>
    mod.subcategories.map((sub) => ({
      params: { module: mod.id, subcategory: sub.id },
      props: { module: mod, subcategory: sub },
    }))
  );
}

interface Props {
  module: Module;
  subcategory: SubCategory;
}

const { module, subcategory } = Astro.props;
const articles = getArticlesBySubcategory(module.id, subcategory.id);
---

<HelpCenterLayout
  title={`${subcategory.title} — ${module.title} — Gilabs Help Center`}
  description={`${subcategory.description}. Panduan dan tutorial untuk ${subcategory.title} di modul ${module.title}.`}
>
  <HelpNavbar />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col lg:flex-row gap-8">
      <Sidebar currentModule={module.id} currentSubcategory={subcategory.id} />

      <main class="flex-1 min-w-0">
        <Breadcrumb items={[
          { label: module.title, href: `/${module.id}` },
          { label: subcategory.title },
        ]} />

        <div class="mb-8">
          <h1 class="text-2xl md:text-3xl font-bold text-foreground">{subcategory.title}</h1>
          <p class="text-muted-foreground mt-2">{subcategory.description}</p>
        </div>

        {articles.length > 0 ? (
          <div class="space-y-3">
            {articles.map((article) => (
              <ArticleCard article={article} />
            ))}
          </div>
        ) : (
          <div class="text-center py-16 border border-dashed border-border rounded-xl">
            <div class="text-muted-foreground">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-4 opacity-40">
                <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/>
              </svg>
              <p class="font-medium">Belum ada artikel</p>
              <p class="text-sm mt-1">Artikel untuk kategori ini sedang dalam proses penulisan.</p>
            </div>
          </div>
        )}
      </main>
    </div>
  </div>

  <HelpFooter />
</HelpCenterLayout>
