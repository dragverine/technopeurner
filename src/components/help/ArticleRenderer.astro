---
import type { ArticleContentBlock } from '@/lib/help-center';

interface Props {
  content: ArticleContentBlock[];
}

const { content } = Astro.props;
---

<div class="article-content space-y-6">
  {content.map((block) => {
    if (block.type === 'heading') {
      const level = block.level || 2;
      const headingClass = {
        1: 'text-3xl font-bold',
        2: 'text-2xl font-bold',
        3: 'text-xl font-semibold',
        4: 'text-lg font-semibold',
      }[level] || 'text-xl font-semibold';
      
      const Tag = `h${level}` as any;
      return <Tag class={`${headingClass} text-foreground mt-6 mb-3`}>{block.body}</Tag>;
    }

    if (block.type === 'text') {
      return (
        <div class="prose-block">
          {block.body?.split('\n').map((line) => (
            <p class="text-foreground leading-relaxed">{line}</p>
          ))}
        </div>
      );
    }

    if (block.type === 'card') {
      return (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 my-6">
          {block.items?.map((item) => (
            <div class="border border-border rounded-lg p-5 hover:border-brand/50 hover:shadow-md transition-all">
              {item.title && (
                <div class="flex items-start gap-3 mb-2">
                  {block.icon && <span class="text-2xl">{block.icon}</span>}
                  <h3 class="font-semibold text-foreground">{item.title}</h3>
                </div>
              )}
              {item.body && (
                <p class="text-sm text-muted-foreground leading-relaxed">{item.body}</p>
              )}
              {item.image && (
                <img
                  src={item.image.src}
                  alt={item.image.alt}
                  class="w-full h-32 object-cover rounded mt-3"
                  loading="lazy"
                />
              )}
            </div>
          ))}
        </div>
      );
    }

    if (block.type === 'collapsible') {
      return (
        <div class="space-y-2">
          {block.items?.map((item, idx) => (
            <details class="border border-border rounded-lg p-4 group cursor-pointer hover:border-brand/50 transition-colors">
              <summary class="flex items-center justify-between font-semibold text-foreground">
                <span class="flex items-center gap-2">
                  {block.icon && <span>{block.icon}</span>}
                  {item.title}
                </span>
                <svg class="w-5 h-5 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
                </svg>
              </summary>
              <div class="mt-3 pt-3 border-t border-border text-muted-foreground leading-relaxed">
                {item.body?.split('\n').map((line) => {
                  if (line.startsWith('- ')) {
                    return <li class="ml-4 list-disc">{line.slice(2)}</li>;
                  }
                  return <p>{line}</p>;
                })}
                {item.image && (
                  <img
                    src={item.image.src}
                    alt={item.image.alt}
                    class="w-full h-auto rounded mt-3"
                    loading="lazy"
                  />
                )}
              </div>
            </details>
          ))}
        </div>
      );
    }

    if (block.type === 'timeline') {
      return (
        <div class="relative my-8">
          <div class="space-y-6">
            {block.items?.map((item, idx) => (
              <div class="flex gap-4">
                <div class="flex flex-col items-center">
                  <div class="w-10 h-10 rounded-full bg-brand text-white flex items-center justify-center font-bold text-sm shrink-0">
                    {block.icon ? <span class="text-lg">{block.icon}</span> : idx + 1}
                  </div>
                  {idx < (block.items?.length || 0) - 1 && (
                    <div class="w-0.5 h-16 bg-border mt-2"></div>
                  )}
                </div>
                <div class="flex-1 pt-1 pb-6">
                  {item.title && (
                    <h4 class="font-semibold text-foreground mb-1">{item.title}</h4>
                  )}
                  {item.body && (
                    <p class="text-sm text-muted-foreground leading-relaxed">{item.body}</p>
                  )}
                  {item.image && (
                    <img
                      src={item.image.src}
                      alt={item.image.alt}
                      class="w-full h-auto rounded mt-3"
                      loading="lazy"
                    />
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      );
    }

    if (block.type === 'step') {
      return (
        <div class="step-block border border-border rounded-xl p-5">
          <div class="flex items-start gap-4">
            <div class="w-8 h-8 rounded-full bg-brand text-white flex items-center justify-center shrink-0 text-sm font-bold">
              {block.stepNumber}
            </div>
            <div class="flex-1 min-w-0">
              {block.title && (
                <h4 class="font-semibold text-foreground mb-2">{block.title}</h4>
              )}
              {block.body && (
                <div class="text-muted-foreground leading-relaxed">
                  {block.body.split('\n').map((line) => {
                    if (line.startsWith('- ')) {
                      return <li class="ml-4 list-disc">{line.slice(2)}</li>;
                    }
                    return <p>{line}</p>;
                  })}
                </div>
              )}
              {block.image && (
                <div class="mt-4 rounded-lg overflow-hidden border border-border bg-secondary/30">
                  <img
                    src={block.image.src}
                    alt={block.image.alt}
                    class="w-full h-auto"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}
            </div>
          </div>
        </div>
      );
    }

    if (block.type === 'info') {
      return (
        <div class="flex gap-3 p-4 bg-blue-50 border border-blue-200 rounded-xl">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600 shrink-0 mt-0.5">
            <circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>
          </svg>
          <p class="text-sm text-blue-800 leading-relaxed">{block.body}</p>
        </div>
      );
    }

    if (block.type === 'warning') {
      return (
        <div class="flex gap-3 p-4 bg-amber-50 border border-amber-200 rounded-xl">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-600 shrink-0 mt-0.5">
            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/>
          </svg>
          <p class="text-sm text-amber-800 leading-relaxed">{block.body}</p>
        </div>
      );
    }

    if (block.type === 'image') {
      return (
        <figure class="rounded-lg overflow-hidden border border-border">
          <img
            src={block.src}
            alt={block.alt || ''}
            class="w-full h-auto"
            loading="lazy"
            decoding="async"
          />
          {block.caption && (
            <figcaption class="text-center text-sm text-muted-foreground p-3 bg-secondary/30">
              {block.caption}
            </figcaption>
          )}
        </figure>
      );
    }

    return null;
  })}
</div>
