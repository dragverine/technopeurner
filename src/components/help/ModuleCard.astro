---
import { getModuleIcon, getArticleCount } from '@/lib/help-center';
import type { Module } from '@/lib/help-center';

interface Props {
  module: Module;
}

const { module } = Astro.props;
const articleCount = getArticleCount(module.id);
---

<a
  href={`/${module.id}`}
  class="group block p-6 border border-border rounded-2xl hover:border-brand/30 hover:shadow-lg hover:shadow-brand/5 transition-all duration-200 bg-background"
>
  <div class="flex items-start gap-4">
    <div
      class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0 text-white"
      style={`background-color: ${module.color}`}
    >
      <span class="w-6 h-6" set:html={getModuleIcon(module.id)} />
    </div>
    <div class="flex-1 min-w-0">
      <h3 class="text-lg font-semibold text-foreground group-hover:text-brand transition-colors">
        {module.title}
      </h3>
      <p class="text-sm text-muted-foreground mt-1 line-clamp-2">
        {module.description}
      </p>
      <div class="flex items-center gap-4 mt-3 text-xs text-muted-foreground">
        <span>{module.subcategories.length} sub-kategori</span>
        <span>{articleCount} artikel</span>
      </div>
    </div>
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground group-hover:text-brand group-hover:translate-x-1 transition-all shrink-0 mt-1">
      <path d="m9 18 6-6-6-6"/>
    </svg>
  </div>
</a>
